# ---------------------------------------------------------------------------
# Codenames Live - environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Flask secret key used to sign session cookies. Generate a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy database URL (MySQL / MariaDB on shared hosting).
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DATABASE?charset=utf8mb4

# Optional separate database used by the test-suite.
TEST_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DATABASE_TEST?charset=utf8mb4

# Super-admin bootstrap credentials.
# Generate the password hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD_HASH=

# Optional message queue for multi-process Socket.IO (e.g. Redis).
# Leave empty for a single-process deployment (shared hosting / Passenger).
SOCKETIO_MESSAGE_QUEUE=

# Socket.IO async mode. "threading" works on shared hosting without
# eventlet/gevent. Use "eventlet" only when the host supports it.
SOCKETIO_ASYNC_MODE=threading

# Cookie hardening - set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Comma separated list of trusted proxy count for ProxyFix (usually 1 behind cPanel).
PROXY_FIX=0
